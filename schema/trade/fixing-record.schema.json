{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fina.local/schema/trade/fixing-record.schema.json",
  "title": "FinA Fixing Record",
  "description": "An immutable, idempotent market observation for a trade and observation date.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixing_id", "trade_id", "fixing_date", "observation_type", "underlyings", "decision", "source", "recorded_at", "idempotency_key"],
  "properties": {
    "fixing_id": {"type": "string", "minLength": 1},
    "trade_id": {"type": "string", "minLength": 1},
    "fixing_date": {"type": "string", "format": "date"},
    "observation_type": {"enum": ["DAILY", "INTRADAY", "FINAL", "CORPORATE_ACTION", "MANUAL_OVERRIDE"]},
    "underlyings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/underlyingFixing"}},
    "decision": {"$ref": "#/$defs/decision"},
    "source": {"$ref": "#/$defs/source"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "underlyingFixing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "fixing"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "reference": {"type": ["number", "null"]},
        "fixing": {"type": "number"},
        "performance": {"type": ["number", "null"]},
        "knock_in_hit": {"type": "boolean"},
        "knock_out_hit": {"type": "boolean"},
        "quality": {"enum": ["FINAL", "PROVISIONAL", "MISSING", "REJECTED"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coupon_status", "knock_status"],
      "properties": {
        "coupon_status": {"enum": ["NOT_DUE", "ACCRUED", "PAID", "WAIVED", "UNKNOWN"]},
        "knock_status": {"enum": ["NONE", "KNOCK_IN", "KNOCK_OUT", "BOTH_REQUIRES_PRECEDENCE", "UNKNOWN"]},
        "next_observation": {"type": ["string", "null"], "format": "date"},
        "state_patch": {"type": "object"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_snapshot_id", "calendar", "fixing_source"],
      "properties": {
        "market_snapshot_id": {"type": "string", "minLength": 1},
        "calendar": {"type": "string", "minLength": 1},
        "fixing_source": {"type": "string", "minLength": 1},
        "source_revision": {"type": ["string", "null"]}
      }
    }
  }
}
