{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fina.local/schema/riskcube/report.schema.json",
  "title": "FinA RiskCube Report",
  "description": "Metadata and query contract for generated risk, P&L, Taylor decomposition, or forecast datasets. Generated measures live in columnar storage, never in this JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_key", "report_kind", "version_key", "scenario_keys", "dataset", "dimensions", "measures", "status"],
  "properties": {
    "report_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "report_kind": {"enum": ["risk", "pnl", "taylor", "forecast"]},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version_key": {"type": "string"},
    "scenario_keys": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "dataset": {"$ref": "#/$defs/dataset"},
    "dimensions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "measures": {"type": "array", "items": {"$ref": "#/$defs/measure"}, "minItems": 1},
    "filter": {"type": ["object", "null"], "additionalProperties": true},
    "status": {"enum": ["draft", "running", "ready", "failed", "retired"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string"}
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_name", "format", "root_uri", "hive_partition_columns", "rfk_columns"],
      "properties": {
        "table_name": {"type": "string"},
        "format": {"const": "parquet"},
        "root_uri": {"type": "string"},
        "duckdb_view": {"type": "string"},
        "hive_partition_columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rfk_columns": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "value_columns": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "label", "value_type"],
      "properties": {
        "column": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string"},
        "value_type": {"enum": ["amount", "rate", "number", "date"]},
        "unit": {"type": ["string", "null"]},
        "description": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "engine_version", "generated_at"],
      "properties": {
        "schema_version": {"type": "string"},
        "engine_version": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"},
        "request_hash": {"type": "string"},
        "source_revision": {"type": "string"}
      }
    }
  }
}
