{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fina.local/schema/model-wiring.schema.json",
  "title": "FinA Model-Wiring Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry",
    "version",
    "product_family",
    "status",
    "terms",
    "pricing_request",
    "lifecycle",
    "market_data",
    "pricing",
    "risk_profiles",
    "evidence"
  ],
  "properties": {
    "registry": {
      "const": "fina/model-wiring"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "product_family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "design",
        "executable",
        "deprecated"
      ]
    },
    "terms": {
      "$ref": "#/$defs/versionedContract"
    },
    "pricing_request": {
      "$ref": "#/$defs/versionedContract"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_schema",
        "events"
      ],
      "properties": {
        "state_schema": {
          "type": "string",
          "minLength": 1
        },
        "event_schema": {
          "type": "string",
          "minLength": 1
        },
        "transition_schema": {
          "type": "string",
          "minLength": 1
        },
        "fixing_record_schema": {
          "type": "string",
          "minLength": 1
        },
        "market_operation_schema": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$"
          },
          "uniqueItems": true
        }
      }
    },
    "market_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "calendar",
        "observation_style",
        "fixing_source"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "calendar": {
          "type": "string",
          "minLength": 1
        },
        "observation_style": {
          "type": "string",
          "minLength": 1
        },
        "fixing_source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_handler",
        "backends"
      ],
      "properties": {
        "logical_handler": {
          "type": "string",
          "minLength": 1
        },
        "path_count": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "bump": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "state_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "backends": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/backend"
          }
        }
      }
    },
    "risk_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/riskProfile"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "partial",
            "verified"
          ]
        },
        "required_engine_marker": {
          "type": "string",
          "minLength": 1
        },
        "parity_reference": {
          "type": "string",
          "minLength": 1
        },
        "e2e_command": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "versionedContract": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema",
        "version"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "callable",
        "allowed_for"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "callable": {
          "type": "string",
          "minLength": 1
        },
        "build_target": {
          "type": "string",
          "minLength": 1
        },
        "engine_marker": {
          "type": "string",
          "minLength": 1
        },
        "required_for": {
          "type": "string",
          "minLength": 1
        },
        "allowed_for": {
          "type": "string",
          "minLength": 1
        },
        "fallback_allowed": {
          "type": "boolean"
        }
      }
    },
    "riskProfile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "measures",
        "method"
      ],
      "properties": {
        "measures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
