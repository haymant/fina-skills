{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fina.local/schema/ui/ui-metadata.schema.json",
  "title": "FinA UI Metadata Entry",
  "description": "Metadata for schema-driven FinAP pages, layouts, fields, workflows, actions, resources, and renderer hints. Domain meaning remains in the referenced JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry",
    "version",
    "kind",
    "id"
  ],
  "properties": {
    "registry": {
      "const": "fina/ui"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "page",
        "layout",
        "workflow",
        "flex-block",
        "field-ui",
        "action",
        "resource"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "root_schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_path": {
      "type": "string",
      "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "process": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "type": "string",
      "minLength": 1
    },
    "result_schema": {
      "type": "string",
      "minLength": 1
    },
    "leg_allocation_schema": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$"
    },
    "confirmation_policy": {
      "enum": [
        "never",
        "when_destructive",
        "always"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/precondition"
      }
    },
    "actor_capability": {
      "type": "string",
      "minLength": 1
    },
    "reason_required": {
      "type": "boolean"
    },
    "idempotency_key_path": {
      "type": "string",
      "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/layoutNode"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflowStep"
      }
    },
    "collection": {
      "$ref": "#/$defs/collection"
    },
    "navigation": {
      "$ref": "#/$defs/navigation"
    },
    "format": {
      "$ref": "#/$defs/format"
    },
    "summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathReference"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "visible_when": {
      "$ref": "#/$defs/condition"
    },
    "enabled_when": {
      "$ref": "#/$defs/condition"
    },
    "record_binding": {
      "type": "string",
      "minLength": 1
    },
    "refresh_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9_-]+)+$"
      },
      "uniqueItems": true
    },
    "evidence_required": {
      "type": "boolean"
    },
    "lifecycle_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "edit_modes": {
      "type": "array",
      "items": {
        "enum": [
          "editable",
          "read-only",
          "diagnostic"
        ]
      },
      "uniqueItems": true
    },
    "argument_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/argumentBinding"
      }
    },
    "required": {
      "type": "boolean"
    },
    "repeatable": {
      "type": "boolean"
    }
  },
  "$defs": {
    "layoutNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "field",
            "layout",
            "workflow",
            "text",
            "divider"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "layout"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "block": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "navigation": {
          "enum": [
            "next",
            "subflow",
            "list-detail"
          ]
        },
        "visible_when": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "item_schema"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        },
        "item_schema": {
          "type": "string",
          "minLength": 1
        },
        "item_title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "next",
            "subflow",
            "list-detail"
          ]
        },
        "list_title": {
          "type": "string",
          "minLength": 1
        },
        "item_title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "enum": [
            "decimal",
            "percent",
            "currency"
          ]
        },
        "display_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "currency_path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        }
      }
    },
    "pathReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        },
        "equals": {},
        "in": {
          "type": "array",
          "minItems": 1
        },
        "not_equals": {}
      },
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "not_equals"
          ]
        }
      ]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "operator"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        },
        "operator": {
          "enum": [
            "equals",
            "in",
            "exists",
            "not_equals"
          ]
        },
        "value": {},
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "argumentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_path",
        "argument_path"
      ],
      "properties": {
        "input_path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        },
        "argument_path": {
          "type": "string",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
